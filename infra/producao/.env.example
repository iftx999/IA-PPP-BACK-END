# Copie para .env e preencha. NUNCA versione o .env. Gere segredos com:  openssl rand -base64 48
# ---- Versão e domínio ----
AURORA_REGISTRO=ghcr.io/iftx999
AURORA_VERSAO=sha-xxxxxxx
AURORA_DOMINIO=aurora.empresa.com.br
AURORA_DOMINIO_ID=id.aurora.empresa.com.br
AURORA_EMAIL_TLS=infra@empresa.com.br
AURORA_AMBIENTE=producao
# Fundo do mapa contratado (origens para a CSP, separadas por espaço). Ex.: https://tiles.provedor.com
AURORA_CSP_MAPA=
# ---- Banco ----
POSTGRES_PASSWORD=
AURORA_OWNER_PASSWORD=
AURORA_APP_PASSWORD=
# ---- Segredos da aplicação ----
AURORA_CHAVE_CURSOR=
AURORA_AUDITORIA_CHAVE=
AURORA_IDENTIDADE_SEGREDO=
# ---- Keycloak ----
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_USUARIO=
KEYCLOAK_ADMIN_SENHA=
AURORA_SMTP_HOST=
AURORA_SMTP_PORTA=587
AURORA_SMTP_REMETENTE=nao-responda@empresa.com.br
AURORA_SMTP_USUARIO=
AURORA_SMTP_SENHA=
# ---- IA (ADR 0019): claude ou openai; vazio desliga ----
AURORA_IA_PROVEDOR=claude
AURORA_IA_CHAVE=
AURORA_IA_OPENAI_CHAVE=
AURORA_IA_OPENAI_MODELO=
# ---- Observabilidade ----
AURORA_TRACING_LIGADO=true
GRAFANA_ADMIN_USUARIO=
GRAFANA_ADMIN_SENHA=
