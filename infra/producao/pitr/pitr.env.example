# Cópia do repositório de backup fora do host (ADR 0039): copie para pitr.env e preencha. Sem pitr.env, os backups
# ficam só no volume local "pitr-repositorio" (protege contra erro humano e corrupção, não contra perder o host).
# Bucket com versionamento e bloqueio de exclusão (object lock), numa conta separada da que roda a aplicação.
PGBACKREST_REPO2_TYPE=s3
PGBACKREST_REPO2_PATH=/aurora
PGBACKREST_REPO2_S3_BUCKET=
PGBACKREST_REPO2_S3_ENDPOINT=s3.sa-east-1.amazonaws.com
PGBACKREST_REPO2_S3_REGION=sa-east-1
PGBACKREST_REPO2_S3_KEY=
PGBACKREST_REPO2_S3_KEY_SECRET=
PGBACKREST_REPO2_CIPHER_TYPE=aes-256-cbc
# Senha própria (>= 32 caracteres), guardada no cofre de segredos: sem ela o backup não é restaurável.
PGBACKREST_REPO2_CIPHER_PASS=
PGBACKREST_REPO2_RETENTION_FULL=8
